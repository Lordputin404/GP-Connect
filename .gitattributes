# Normalize text files; keep line endings predictable across Windows/Linux.
* text=auto

# gradlew must stay LF so it runs on the Linux CI runner.
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf
*.kt text
*.kts text
*.xml text
*.toml text
*.properties text
*.yml text
*.yaml text

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.zip binary
*.jks binary
*.keystore binary
