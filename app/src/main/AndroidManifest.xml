<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by Firebase network access (Phase 4+); harmless for mock data. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications (FCM). Runtime-requested on Android 13+; on older
         versions it is granted at install time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GPConnectApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GPConnect">

        <!-- Channel the system tray uses to show FCM notification messages
             while the app is in the background (foreground deliveries go
             through GPConnectMessagingService instead). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="gp_connect_notifications" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GPConnect.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM client service: receives push deliveries. -->
        <service
            android:name=".notifications.GPConnectMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
