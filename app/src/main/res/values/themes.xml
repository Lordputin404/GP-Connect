<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme after the splash screen dismisses (Compose draws content). -->
    <style name="Theme.GPConnect" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Android 12+ / core-splashscreen branded splash: brand-indigo background
         with the official emblem (via the launcher adaptive icon) on a white
         icon plate. No artificial delay. -->
    <style name="Theme.GPConnect.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.GPConnect</item>
    </style>
</resources>
