rules_version = '2';

// GP Connect — Firebase Storage Security Rules
//
// DEPLOY THIS FILE:
//   firebase deploy --only storage
// (firebase.json in the repo root points at this file.)
//
// Storage layout
// --------------
//   calendarEvents/{eventId}/attachments/{uniqueFileName}
//     Binary attachments of College Calendar events. Firestore (not Storage)
//     holds each event's attachment metadata; this tree holds the files.
//
// Authority model (mirrors firestore.rules)
// -----------------------------------------
//   SUPER_ADMIN    uploads/deletes calendar event attachments. Only that
//                  role can write calendarEvents anywhere (Firestore rules
//                  enforce the same on the event documents).
//   Members        STUDENT/TEACHER — any signed-in *enabled* user whose
//                  users/{uid} profile exists — may READ attachments whose
//                  calendarEvents/{eventId} document exists and is
//                  published. An unpublished (draft) event's files are
//                  therefore not member-accessible.
//
// Invariants
// ----------
//  1. No public/default access: files are readable only through rules-checked
//     Firebase SDK access. The app never uses tokenized download URLs (the
//     downloadUrl metadata field is intentionally left empty), so nothing is
//     publicly openable.
//  2. Reads are tied to the owning event's published state, so pulling a
//     draft's file requires the SUPER_ADMIN role.
//  3. Uploads are restricted to the PDF/DOC/DOCX/JPG/JPEG/PNG/WebP content
//     types and a 10 MB ceiling per file.
//  4. Deletions are SUPER_ADMIN-only — the admin UI's remove/delete flows
//     go through these same rules.
//
// Cross-service note: firestore.get() can read only the default Firestore
// database, and at most two documents per evaluation — exactly what the
// member read path below uses (the caller's profile + the event document).

service firebase.storage {
  match /b/{bucket}/o {

    function callerProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isEnabled() {
      return request.auth != null && callerProfile().enabled == true;
    }

    function isSuperAdmin() {
      return request.auth != null && callerProfile().role == 'SUPER_ADMIN';
    }

    // The calendarEvents/{eventId} document; its isPublished flag governs
    // member reads.
    function eventDoc(eventId) {
      return firestore.get(/databases/(default)/documents/calendarEvents/$(eventId)).data;
    }

    // Valid content types for calendar event attachments, mirrored from
    // EventAttachmentType in the app model.
    function isAllowedMimeType(type) {
      return type == 'application/pdf' ||
        type == 'application/msword' ||
        type == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
        type == 'image/jpeg' ||
        type == 'image/png' ||
        type == 'image/webp';
    }

    match /calendarEvents/{eventId}/attachments/{fileName} {
      // Members: read files of *published* events only (drafts stay private).
      // SUPER_ADMIN: reads everything, including drafts. The member path
      // reads two Firestore documents (profile + event) — the per-evaluation
      // maximum.
      allow read: if isSuperAdmin() ||
        (isEnabled() && eventDoc(eventId).isPublished == true);

      // Uploads: SUPER_ADMIN only, allowed content types, max 10 MB. The
      // event document need not exist yet — creation uploads target a
      // pre-allocated event ID before the Firestore document is written.
      allow create, update: if isSuperAdmin() &&
        isAllowedMimeType(request.resource.contentType) &&
        request.resource.size <= 10 * 1024 * 1024;

      // Deletions: SUPER_ADMIN only (mirrors the calendarEvents rules).
      allow delete: if isSuperAdmin();
    }
  }
}
